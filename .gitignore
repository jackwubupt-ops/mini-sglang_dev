# pycache
__pycache__/
*.py[cod]
*$py.class

# installed packages
*.dist-info/
*.egg-info/

# json files
*.json
*.jsonl

# profiling data
*.nsys-rep
*.ncu-rep

# binaries
build/
dist/
*.tar.gz

# virtual environment
.venv/
venv/
env/

# clangd config
.clangd

# .vscode
.vscode/
.coverage

# project: server/bench logs stay local
logs/

# project: secrets, agent sessions, raw run data, caches and weights never enter Git
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*token*.txt
.claude/
.codex/
runs/
rental/
cache/
.cache/
*.safetensors
*.bin
*.pt
*.pth
*.gguf

# project: raw results and golden outputs must be tracked despite *.json/*.jsonl above
!results/**/*.json
!results/**/*.jsonl
!tests/golden/**/*.json
!tests/golden/**/*.jsonl
